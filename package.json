{
  "name": "isokit",
  "private": true,
  "type": "module",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "dev": "bun run --cwd site dev",
    "build": "bun run --cwd site build",
    "test": "cd skill && bun test ./lib ./examples",
    "size": "bun run --cwd site size",
    "check:names": "sh scripts/check-names.sh",
    "readme:svg": "bun scripts/readme-svg.ts",
    "check:contrast": "bun skill/scripts/render-all.ts .contrast && node skill/scripts/contrast.mjs .contrast/*.html",
    "check:order": "bun skill/scripts/render-all.ts .order && node skill/scripts/order.mjs .order/*.html"
  }
}
