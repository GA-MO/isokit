---
const is = ['A skill for Claude Code and other agents that read Agent Skills', 'Plain SVG and CSS with a 1.7 kB player and no dependencies, or one standalone SVG', 'Your code: plain SVG and CSS you can read, edit and own'];
const isnt = ['An animation library to install and learn', 'A hosted service, an editor or a subscription', 'A template pack: every scene is drawn for your story'];
const columns = [
  { title: 'What it is', items: is, mark: 'M3 6.5 5.2 8.7 9.5 3.8', tone: 'bg-accent-soft text-accent' },
  { title: "What it isn't", items: isnt, mark: 'M3.5 3.5l5 5M8.5 3.5l-5 5', tone: 'bg-raised text-muted' },
];
---

<section aria-label="What it is and what it isn't" class="mx-auto mt-16 w-full max-w-7xl px-5 sm:mt-20 sm:px-8">
  <div class="grid overflow-hidden rounded-3xl border border-line md:grid-cols-2">
    {
      columns.map((c, i) => (
        <div class:list={['p-6 sm:p-8', i === 0 ? 'bg-panel' : 'border-t border-line md:border-t-0 md:border-l']}>
          <h2 class="text-lg font-semibold tracking-tight">{c.title}</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {c.items.map(item => (
              <li class="flex gap-3 text-pretty text-muted">
                <span class:list={['mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full', c.tone]} aria-hidden="true">
                  <svg viewBox="0 0 12 12" class="size-3"><path d={c.mark} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span class:list={[i === 0 && 'text-ink']}>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
