---
import { hero } from '../../../skill/examples/hero';
import { repo } from '../content';

const facts = ['SVG + WAAPI', 'no animation library', 'pauses off screen', 'still for reduced motion'];
---

<section id="top" class="surface-dark overflow-hidden">
  <div class="mx-auto w-full max-w-7xl px-5 pt-10 sm:px-8 sm:pt-16 lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-8 lg:py-12">
    <div class="lg:col-span-5">
      <h1 class="text-4xl font-semibold tracking-tighter text-balance sm:text-6xl lg:text-5xl xl:text-6xl">
        Isometric explainers, drawn from a prompt.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-muted sm:mt-6 sm:text-xl lg:text-lg xl:text-xl">
        Tell Claude Code the story of your product. The iso skill draws it as an animated isometric scene in plain SVG, ready for your landing page.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3 sm:mt-9">
        <a href="#install" class="inline-flex h-11 items-center rounded-full bg-ink px-6 text-sm font-semibold text-page transition-colors duration-150 hover:bg-white">
          Get started
        </a>
        <a href={repo} class="inline-flex h-11 items-center rounded-full border border-line-strong px-6 text-sm font-semibold text-ink transition-colors duration-150 hover:border-ink">
          GitHub
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted sm:mt-8 sm:gap-x-5" aria-label="Facts">
        {facts.map(f => <li>{f}</li>)}
      </ul>
    </div>
    <div class="-mx-5 mt-8 overflow-hidden sm:mx-0 sm:mt-12 lg:col-span-7 lg:mt-0" set:html={hero.html} />
  </div>
</section>
