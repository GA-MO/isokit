---
import { gzipSync } from 'node:zlib';
import { stage, stories } from '../../../skill/examples/hero';

const kb = (svg: string) => Math.round(gzipSync(svg, { level: 9 }).length / 1024);
const lines = stories.map(story => {
  const chars = [...story.prompt];
  return {
    ...story,
    chars,
    progress: [
      { at: 450, mark: '⏺', text: story.beats },
      { at: 1300, mark: '⏺', text: `Drawing ${story.file} with the kit` },
      { at: 2600, mark: '✓', text: `1 SVG file · no dependencies · ${kb(story.art.wide!.scene.exportSvg())} kB gzip`, ok: true },
    ],
  };
});
const steps = [
  { title: 'Describe it', body: 'One sentence about how your product works: what arrives, what moves where, what lights up.' },
  { title: 'Claude storyboards and draws it', body: 'The skill breaks the sentence into three to six beats from measured motion recipes, then draws each one.' },
  { title: 'Paste the SVG into your site', body: 'Plain SVG with a 1.7 kB player: it plays in view, pauses off screen and holds a still for reduced motion. Or one standalone SVG for a README.' },
];
---

<section id="top" class="flex flex-col overflow-hidden">
  <div class="mx-auto w-full max-w-7xl px-5 pt-8 sm:px-8 sm:pt-14">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-panel py-1 pl-2 pr-3 text-xs font-medium text-muted sm:text-sm">
      <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-semibold text-accent">Claude Code skill</span>
      Free and open source
    </p>
    <h1 class="mt-5 max-w-6xl text-3xl font-semibold tracking-tighter text-balance sm:text-5xl">
      Explain how your product works in one sentence.{' '}
      <span class="text-muted lg:block">Get an animated diagram for your landing page.</span>
    </h1>
  </div>
  <div class="mx-auto w-full max-w-7xl max-lg:contents lg:mt-6 lg:flex lg:items-end lg:justify-between lg:gap-6 lg:px-8">
    <div class="max-lg:order-3 max-lg:mx-auto max-lg:mt-8 max-lg:w-full max-lg:max-w-7xl max-lg:px-5 sm:max-lg:px-8">
      <p class="max-w-2xl text-lg leading-relaxed text-pretty text-muted">
        Claude turns your sentence into an animated isometric explainer in plain SVG, ready for a landing page, your docs or a deck.
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-3 max-lg:order-1 max-lg:mx-auto max-lg:mt-6 max-lg:w-full max-lg:max-w-7xl max-lg:px-5 sm:max-lg:px-8">
      <a href="#install" class="inline-flex h-11 items-center rounded-full bg-ink px-6 text-sm font-semibold text-page transition-colors duration-150 hover:bg-accent">
        Get started
      </a>
      <a href="#showcase" class="inline-flex h-11 items-center rounded-full border border-line-strong bg-page px-6 text-sm font-semibold text-ink transition-colors duration-150 hover:border-ink">
        See examples
      </a>
    </div>
  </div>

  <div class="mx-auto mt-6 w-full max-w-7xl px-3 max-lg:order-2 sm:px-8 lg:mt-10" data-hero>
    <div class="flex flex-col items-stretch gap-3 overflow-hidden rounded-3xl border border-line bg-panel p-2 sm:p-4 lg:flex-row lg:items-center lg:gap-0 lg:p-6">
      <div class="relative z-10 flex flex-col gap-3 lg:w-5/12 lg:shrink-0">
        <figure class="overflow-hidden rounded-2xl bg-terminal text-terminal-ink shadow-2xl ring-1 shadow-ink/20 ring-ink/10">
          <div class="flex h-10 items-center gap-1.5 border-b border-terminal-line px-4">
            {[0, 1, 2].map(() => <span class="size-2.5 rounded-full bg-terminal-line" aria-hidden="true" />)}
            <span class="ml-3 grid font-mono text-xs text-terminal-muted">
              {lines.map((story, i) => <span class="col-start-1 row-start-1 not-data-on:invisible" data-line={i} data-on={i === 0 ? '' : undefined}>claude · {story.dir}</span>)}
            </span>
          </div>
          <div class="grid px-4 pt-4 pb-5 font-mono text-sm leading-relaxed sm:px-5" data-terminal>
            {
              lines.map((story, i) => (
                <div class="col-start-1 row-start-1 not-data-on:invisible" data-line={i} data-on={i === 0 ? '' : undefined} style={`--n:${story.chars.length}`}>
                  <p>
                    <span class="sr-only">{story.prompt}</span>
                    <span class="text-terminal-accent" aria-hidden="true">&gt;</span>{' '}
                    <span class="type-in" aria-hidden="true">{story.chars.map((c, n) => <span style={`--i:${n}`}>{c}</span>)}</span><span
                      class="caret ml-0.5 inline-block h-4 w-2 translate-y-0.5 bg-terminal-accent"
                      aria-hidden="true"
                    />
                  </p>
                  <ul class="mt-4 hidden flex-col gap-1.5 text-terminal-muted sm:flex" aria-hidden="true">
                    {
                      story.progress.map(p => (
                        <li class="reveal flex gap-2" style={`--at:${p.at}ms`}>
                          <span class:list={[p.ok ? 'text-terminal-ok' : 'text-terminal-accent']}>{p.mark}</span>
                          <span class:list={[p.ok && 'text-terminal-ink']}>{p.text}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              ))
            }
          </div>
        </figure>
        <div role="tablist" aria-label="Example prompts" class="grid grid-cols-2 gap-2">
          {
            lines.map((story, i) => (
              <button
                type="button"
                role="tab"
                id={`hero-tab-${story.slug}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="hero-scene"
                tabindex={i === 0 ? 0 : -1}
                data-prompt={story.prompt}
                data-peak={story.peak}
                class="relative inline-flex h-10 min-w-0 items-center gap-2 overflow-hidden rounded-full border border-line bg-page/60 px-4 text-sm font-medium text-muted transition-colors duration-150 hover:border-line-strong hover:text-ink aria-selected:border-line-strong aria-selected:bg-page aria-selected:text-ink aria-selected:shadow-sm"
              >
                <span class="size-2.5 shrink-0 rounded-full ring-1 ring-ink/10" style={`background:${story.swatch}`} aria-hidden="true" />
                {story.label}
                <span class="absolute inset-x-4 bottom-1 h-0.5 origin-left rounded-full bg-accent/50" style="scale:0 1" aria-hidden="true" data-progress />
              </button>
            ))
          }
        </div>
      </div>
      <div class="relative z-20 flex items-center justify-center lg:-mr-6 lg:w-12 lg:shrink-0" aria-hidden="true">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-page px-3 py-1 font-mono text-xs font-medium whitespace-nowrap text-accent shadow-sm lg:-translate-x-3">
          1 prompt
          <svg viewBox="0 0 12 12" class="size-3 rotate-90 lg:rotate-0"><path d="M2 6h8M7 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </div>
      <div id="hero-scene" role="tabpanel" aria-labelledby={`hero-tab-${lines[0]!.slug}`} class="grid min-w-0 flex-1">
        <div class="col-start-1 row-start-1" set:html={stage.html} />
        {
          lines.map((story, i) => (
            <div class="col-start-1 row-start-1 data-off:invisible" data-panel={i} data-off={i === 0 ? undefined : ''} data-src={i === 0 ? undefined : `${import.meta.env.BASE_URL}scenes/hero-${story.slug}.html`}>
              <p class="sr-only">{story.alt}</p>
              {i === 0 && <Fragment set:html={story.art.html} />}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <ol class="mx-auto mt-10 grid w-full max-w-7xl max-lg:order-4 gap-6 px-5 sm:mt-14 sm:px-8 md:grid-cols-3 md:gap-8">
    {
      steps.map((step, i) => (
        <li class="flex gap-4 border-t border-line pt-5">
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent-soft font-mono text-xs font-semibold text-accent">{i + 1}</span>
          <div>
            <h2 class="font-semibold tracking-tight">{step.title}</h2>
            <p class="mt-1 text-sm leading-relaxed text-pretty text-muted">{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { playHero } from '../scripts/hero';
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero]')) playHero(root);
</script>
