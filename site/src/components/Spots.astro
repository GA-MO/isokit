---
import { examples } from '../../../skill/examples/catalog';
import Art from './Art.astro';

const spots = examples.filter(e => e.level === 'spot');
---

<section id="spots" aria-labelledby="spots-title" class="border-t border-line py-16 sm:py-20">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id="spots-title" class="text-xl font-semibold tracking-tight text-balance">Also draws small spot illustrations for feature lists and empty states.</h2>
      <p class="text-sm text-muted">{spots.length} single objects, one prompt each.</p>
    </div>
    <ul class="-mx-5 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-4 sm:overflow-visible sm:px-0 lg:grid-cols-7">
      {
        spots.map(e => (
          <li class:list={[`surface-${e.surface}`, 'surface-card flex w-40 shrink-0 snap-start flex-col overflow-hidden rounded-2xl border border-surface-line text-surface-ink sm:w-auto']}>
            <div class="p-1.5">
              <Art art={e.art} />
            </div>
            <p class="mt-auto px-3 pb-3 text-xs leading-snug text-surface-muted">{e.ask}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
