---
import { examples } from '../../../skill/examples/catalog';
import { levelOrder, levels } from '../content';
import ExampleCard from './ExampleCard.astro';

const groups = levelOrder
  .map(level => ({ level, ...levels[level], items: examples.filter(e => e.level === level) }))
  .filter(g => g.items.length > 0);
const useCases = [...new Set(examples.map(e => e.useCase))];
const chip =
  'h-8 shrink-0 rounded-full border border-line px-3.5 text-sm text-muted transition-colors duration-150 hover:border-line-strong hover:text-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-page';
---

<section id="showcase" data-showcase class="surface-dark py-24 sm:py-32">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <h2 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Live scenes, each with the prompt behind it.</h2>
      <p class="mt-4 text-lg text-pretty text-muted">
        {examples.length} {examples.length === 1 ? "example" : "examples"}, from a single fan-out to a whole system. Copy any prompt and make it yours.
      </p>
    </div>

    {
      useCases.length > 1 && (
        <div class="-mx-5 mt-8 overflow-x-auto px-5 sm:mx-0 sm:overflow-visible sm:px-0" role="group" aria-label="Filter by use case">
          <div class="flex gap-2 py-2 sm:flex-wrap">
            <button type="button" data-filter="" aria-pressed="true" class={chip}>
              All
            </button>
            {useCases.map(u => (
              <button type="button" data-filter={u} aria-pressed="false" class={chip}>
                {u}
              </button>
            ))}
          </div>
        </div>
      )
    }

    <div class="mt-16 flex flex-col gap-20 sm:gap-24">
      {
        groups.map(g => (
          <section data-group aria-labelledby={`level-${g.level}`}>
            <header class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line pb-4">
              <h3 id={`level-${g.level}`} class="text-2xl font-semibold tracking-tight">
                {g.name}
              </h3>
              <p class="text-sm text-muted">{g.note}</p>
            </header>
            <p data-empty hidden class="rounded-2xl border border-dashed border-line px-5 py-6 text-sm text-muted">
              No {g.name.toLowerCase()} scene for <span data-empty-filter class="text-ink" />.{' '}
              <button type="button" data-filter="" class="font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink">
                Show all
              </button>
            </p>
            <div class:list={['grid gap-5 sm:gap-6', g.level !== 'complex' && 'lg:grid-cols-2']}>
              {g.items.map(example => (
                <ExampleCard example={example} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');

  function apply(filter: string) {
    if (!root) return;
    for (const chip of root.querySelectorAll<HTMLButtonElement>('[role=group] [data-filter]')) {
      chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter));
    }
    for (const group of root.querySelectorAll<HTMLElement>('[data-group]')) {
      let shown = 0;
      for (const card of group.querySelectorAll<HTMLElement>('[data-card]')) {
        card.hidden = filter !== '' && card.dataset.useCase !== filter;
        if (!card.hidden) shown++;
      }
      const empty = group.querySelector<HTMLElement>('[data-empty]');
      const name = group.querySelector('[data-empty-filter]');
      if (empty) empty.hidden = shown > 0;
      if (name) name.textContent = filter;
    }
  }

  root?.addEventListener('click', event => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-filter]') : null;
    if (button) apply(button.dataset.filter ?? '');
  });
</script>
