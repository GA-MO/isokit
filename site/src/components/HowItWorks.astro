---
import CodeBlock from './CodeBlock.astro';

const snippet = `const s = new Scene({ name: 'deploy', width: 720, height: 400 });

s.wire({ id: 'w', points: [[60, 0, 0], [220, 0, 0]], stroke: ui.wire });
s.pulse({ id: 'p', wire: 'w', color: accent });
s.slab({ id: 'build', at: [0, 0, 0], size: [120, 120], height: 28,
  top: ui.top, side: paints.gradient(s, ramps.violet) });

s.dropIn('build', 0.1);
s.loop(6, 2.2);
s.travel('p', 0.4);`;
---

<section id="how" class="surface-dark border-t border-line py-24 sm:py-32">
  <div class="mx-auto grid w-full max-w-7xl gap-8 px-5 sm:px-8 lg:grid-cols-5 lg:items-center">
    <div class="lg:col-span-2">
      <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">What Claude writes for you.</h2>
      <p class="mt-4 max-w-md leading-relaxed text-pretty text-muted">
        A scene is a short TypeScript file: objects on an isometric plane, then motion on a timeline. Read it, tweak a timing and render again. The output is plain SVG with CSS and a 1.7 kB player, or one SVG that animates with CSS alone.
      </p>
    </div>
    <div class="min-w-0 lg:col-span-3">
      <CodeBlock code={snippet} title="deploy.ts" highlight={{ lang: 'ts', theme: 'min-dark' }} />
    </div>
  </div>
</section>
