---
import CodeBlock from './CodeBlock.astro';

const steps = [
  {
    title: 'Describe the story',
    body: 'Say what the viewer should understand in one prompt: what arrives, what travels where, what lights up.',
  },
  {
    title: 'Claude storyboards and draws',
    body: 'The skill turns the story into three to six beats from its measured recipes, then draws each beat with the kit.',
  },
  {
    title: 'Ship static SVG',
    body: 'You get plain SVG and a small runtime. It plays when scrolled into view, pauses off screen and shows a still for reduced motion.',
  },
];

const snippet = `const s = new Scene({ name: 'deploy', width: 720, height: 400 });

s.wire({ id: 'w', points: [[60, 0, 0], [220, 0, 0]], stroke: ui.wire });
s.pulse({ id: 'p', wire: 'w', color: accent });
s.slab({ id: 'build', at: [0, 0, 0], size: [120, 120], height: 28,
  top: ui.top, side: { kind: 'marble', colors: ramps.violet } });

s.dropIn('build', 0.1);
s.loop(6, 2.2);
s.travel('p', 0.4);`;
---

<section id="how" class="surface-light bg-paper py-24 text-paper-ink sm:py-32">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
    <h2 class="max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">From a sentence to a scene in three steps.</h2>
    <ol class="mt-14 grid gap-10 sm:mt-16 md:grid-cols-3 md:gap-8">
      {
        steps.map((step, i) => (
          <li class="border-t border-paper-line pt-6">
            <span class="font-mono text-sm text-paper-muted">{i + 1}</span>
            <h3 class="mt-3 text-xl font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-2 max-w-sm leading-relaxed text-pretty text-paper-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-16 grid gap-8 lg:grid-cols-5 lg:items-center">
      <div class="lg:col-span-2">
        <h3 class="text-xl font-semibold tracking-tight">What Claude writes for you</h3>
        <p class="mt-2 max-w-md leading-relaxed text-pretty text-paper-muted">
          A scene is a short TypeScript file: objects on an isometric plane, then motion on a timeline. You can read it, tweak a timing and render again.
        </p>
      </div>
      <div class="min-w-0 lg:col-span-3">
        <CodeBlock code={snippet} title="deploy.ts" highlight={{ lang: 'ts', theme: 'min-light' }} />
      </div>
    </div>
  </div>
</section>
