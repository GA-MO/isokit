---
import type { Example } from '../../../skill/examples/shared';
import { hints } from '../content';
import Art from './Art.astro';
import CopyButton from './CopyButton.astro';
import LevelBadge from './LevelBadge.astro';

interface Props {
  example: Example;
}

const { example } = Astro.props;
const hint = hints[example.interaction];
---

<article
  data-card
  data-category={example.category}
  class:list={[`surface-${example.surface}`, 'flex min-w-0 flex-col overflow-hidden rounded-3xl border border-surface-line bg-surface text-surface-ink']}
>
  <div class="relative px-2 pt-2 sm:px-4 sm:pt-4">
    <Art art={example.art} />
    {
      hint && (
        <span class="pointer-events-none absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border border-surface-line bg-surface-well px-2.5 py-1 text-xs font-medium text-surface-muted sm:right-6 sm:top-6">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
          <span class="pointer-coarse:hidden">{hint.fine}</span>
          <span class="hidden pointer-coarse:inline">{hint.coarse}</span>
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-5 border-t border-surface-line p-5 sm:p-7">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <LevelBadge level={example.level} />
      <span class="rounded-full border border-surface-line px-2.5 py-0.5 text-xs text-surface-muted">{example.useCase}</span>
    </div>
    <div>
      <h4 class="text-lg font-semibold tracking-tight text-balance">{example.title}</h4>
      <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-pretty text-surface-muted">{example.story}</p>
    </div>
    <div class="mt-auto rounded-2xl border border-surface-line bg-surface-well">
      <div class="flex items-center justify-between gap-3 py-2 pl-4 pr-2">
        <span class="text-xs font-medium text-surface-muted">Prompt</span>
        <CopyButton text={example.prompt} label={`Copy the prompt for ${example.title}`} />
      </div>
      <p class="px-4 pb-4 font-mono text-sm leading-relaxed break-words text-surface-ink">{example.prompt}</p>
    </div>
  </div>
</article>
